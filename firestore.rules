rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT MODE: Full access untuk authenticated users
    // IMPORTANT: Ganti rules ini dengan yang lebih ketat untuk production!
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

// PRODUCTION RULES (uncomment when ready for production):
